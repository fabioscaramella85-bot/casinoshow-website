# Server-only. Never prefix these names with NEXT_PUBLIC_.
# Use a Casino Show Resend account. Do not reuse Fun Casinò credentials.
# CASINO_SHOW_EMAIL_FROM must be a sender on a domain verified in Resend.
# The form reports success only after Resend accepts the message.
# The curriculum is attached to that email and is not stored on the server.

RESEND_API_KEY=
CASINO_SHOW_EMAIL_FROM=
CASINO_SHOW_EMAIL_TO=info@casinoshow.ch

# Quote requests stay off until the recipient, the verified sender, Resend,
# the approved privacy text, and the hosting protections are confirmed.
# Only the exact value enabled turns delivery on. Any other value keeps it off.
CASINO_SHOW_QUOTE_DELIVERY=

# Public preview deployment only. Leave this empty on the future production
# project for casinoshow.ch. Set it before the build and keep it at runtime.
# Only the exact value enabled turns preview mode on. There is no password.
# While it is enabled, pages stay public, search engines are asked not to index
# them, and quote and careers mail cannot be sent.
CASINO_SHOW_PREVIEW_MODE=
